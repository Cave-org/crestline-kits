# Copy this file to .env and fill in the values. Never commit .env.

# Postgres connection string (Neon, Supabase, Railway or a local Postgres all work)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/crestline?sslmode=verify-full"

# Random string, at least 32 characters. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Public URL of the site, used for Paystack's redirect after payment
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Paystack secret key (use sk_test_... while testing, sk_live_... when you launch)
PAYSTACK_SECRET_KEY=""

# Admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@crestlinekits.com"
ADMIN_PASSWORD=""
